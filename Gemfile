source 'https://rubygems.org'

# Ruby version requirement
ruby '>= 3.1'

# Chef testing and development gems
gem 'chefspec', '~> 9.3'        # For ChefSpec unit testing (includes Fauxhai)
gem 'berkshelf', '~> 8.1'       # For managing cookbook dependencies
gem 'rspec', '~> 3.12'          # For running RSpec tests
gem 'cookstyle', '~> 7.31'      # For linting Chef cookbooks (replaces foodcritic)
gem 'rubocop', '~> 1.25'        # For Ruby code style enforcement
gem 'test-kitchen', '~> 3.9'    # For integration testing
gem 'kitchen-vagrant', '~> 2.1' # For Vagrant driver in Test Kitchen

# Note: fauxhai is now bundled with chefspec and no longer needed as a separate gem
# Note: foodcritic is deprecated - use cookstyle instead